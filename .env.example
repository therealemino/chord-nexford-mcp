# ─── Server: required ────────────────────────────────────────────────────────
# The server refuses to start if any of these are missing.

PORT=3000

MCP_BEARER_TOKEN=change-me-to-a-long-random-string
# Separate token for the internal /mcp-admin endpoint. Must differ from MCP_BEARER_TOKEN.
ADMIN_MCP_BEARER_TOKEN=change-me-to-a-different-long-random-string

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

PAYSTACK_SECRET_KEY=sk_test_

PUBLIC_BASE_URL=http://localhost:3000

# ─── Chord: proactive payment confirmations ──────────────────────────────────
# takeover (default) | scheduled_task | off
# The three CHORD_* values below are required unless this is "off".
# (scheduled_task currently fails inside Chord; see "Known Chord issues" in the README.)
CHORD_NOTIFY_STRATEGY=takeover

CHORD_API_KEY=
CHORD_WORKSPACE_ID=
CHORD_TEAMMATE_ID=

RESEND_API_KEY=
ALERT_EMAIL_FROM="Nexford Admissions Bot <hi@eminotechnologies.com>"
ALERT_EMAIL_TO=chord-enquirie@yopmail.com


# ─── Local scripts ───────────────────────────────
# `pnpm db:push` / `pnpm db:seed`: Supabase dashboard → Connect → Session pooler, with your database password.
DATABASE_URL=<should-be-a-postgres-connection-string--pooler>

# `pnpm smoke`: MCP endpoint to test. Defaults to PUBLIC_BASE_URL/mcp; also uses MCP_BEARER_TOKEN.
MCP_URL=
CHORD_OWNER_ID=
