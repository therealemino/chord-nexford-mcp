PORT=3000
# Long random string; Chord sends it as "Authorization: Bearer <token>"
MCP_BEARER_TOKEN=change-me-to-a-long-random-string
# Separate token for the internal /mcp-admin endpoint; must differ from MCP_BEARER_TOKEN
ADMIN_MCP_BEARER_TOKEN=change-me-to-a-different-long-random-string
SUPABASE_URL=https://your-project.supabase.co
# Server-side only. Never expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Test mode only: the server refuses to start unless this starts with sk_test_
PAYSTACK_SECRET_KEY=sk_test_
# Public URL of this server, no trailing slash (used for Paystack callback_url)
PUBLIC_BASE_URL=http://localhost:3000
# Only for `pnpm db:push` / `pnpm db:seed` (not used by the server).
# Supabase dashboard → Connect → Session pooler, with your database password filled in.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Proactive payment confirmations in the customer's Chord thread.
# takeover (default) | scheduled_task | off. The CHORD_* values below are required unless this is "off".
CHORD_NOTIFY_STRATEGY=takeover
# Needs thread:read, thread:write, teammate:read, teammate:update
CHORD_API_KEY=
CHORD_WORKSPACE_ID=
# The WhatsApp admissions teammate
CHORD_TEAMMATE_ID=
