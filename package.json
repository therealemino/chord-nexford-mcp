{
  "name": "nexford-admissions-mcp",
  "version": "1.0.0",
  "description": "MCP server + Paystack webhook for a Nexford admissions agent on Chord (prototype)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "db:push": "tsx scripts/db.ts push",
    "db:seed": "tsx scripts/db.ts seed",
    "chord:discover": "tsx scripts/chord-discover.ts",
    "chord:setup-alerts": "tsx scripts/chord-setup-alerts.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "luxon": "^3.7.2",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pg": "^8.23.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.10.1"
}
